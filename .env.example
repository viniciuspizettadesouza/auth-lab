DATABASE_URL=postgresql://authlab:authlab@postgres:5432/authlab
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAILPIT_URL=http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Auth Lab <auth@auth-lab.local>
AUTH_LAB_POSTGRES_PORT=5433
# Optional local-provider key separation. Defaults are derived from
# BETTER_AUTH_SECRET and are suitable only for the in-process teaching IdP.
# LOCAL_OIDC_CLIENT_SECRET=
# LOCAL_OIDC_SIGNING_SECRET=
# Optional synthetic workload-platform issuer key separation. The default is
# derived from BETTER_AUTH_SECRET and is only for this local teaching issuer.
# WORKLOAD_PLATFORM_SIGNING_SECRET=
